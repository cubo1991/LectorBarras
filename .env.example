# Postgres (Supabase vía integración de Vercel). Usar la connection string pooled (pgbouncer) para la app.
DATABASE_URL=postgres://user:password@host:6543/dbname?sslmode=require&pgbouncer=true

# Connection string directa (sin pgbouncer), la necesitan drizzle-kit generate/migrate/studio.
DATABASE_URL_UNPOOLED=postgres://user:password@host:5432/dbname?sslmode=require

# generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
